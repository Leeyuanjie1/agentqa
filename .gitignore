# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
*$py.class

# Virtual environments
.venv/
venv/
.python-version

# Local environment files
.env
.env.*
!.env.example

# Test, coverage, and tool caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Packaging artifacts
build/
dist/
site/
.eggs/
*.egg-info/
pip-wheel-metadata/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log

# Local project data
data/artifacts/*
!data/artifacts/.gitkeep
data/input/*
!data/input/.gitkeep
models/
docs/
