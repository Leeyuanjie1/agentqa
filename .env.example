DOCQA_PDF_PATH=data/input
DOCQA_ARTIFACT_DIR=data/artifacts/attachment
DOCQA_APP_NAME=docqa-agent
DOCQA_ENVIRONMENT=dev
DOCQA_LOG_LEVEL=INFO
DOCQA_EMBEDDING_MODEL_PATH=models/bge-m3
DOCQA_RERANKER_MODEL_PATH=models/bge-reranker-large
DOCQA_GENERATOR_MODE=extractive
DOCQA_LLM_BASE_URL=
DOCQA_LLM_API_KEY=
DOCQA_LLM_MODEL=
DOCQA_OCR_API_URL=
DOCQA_OCR_API_KEY=
DOCQA_OCR_MODEL=PaddleOCR-VL-1.6
DOCQA_OCR_TIMEOUT=60
DOCQA_OCR_POLL_INTERVAL=5
DOCQA_OCR_USE_DOC_ORIENTATION_CLASSIFY=false
DOCQA_OCR_USE_DOC_UNWARPING=false
DOCQA_OCR_USE_CHART_RECOGNITION=false
DOCQA_OCR_FAIL_FAST=false
DOCQA_TOP_K=8
DOCQA_VECTOR_WEIGHT=0.55
DOCQA_BM25_WEIGHT=0.45
DOCQA_RERANK_THRESHOLD=0.15
DOCQA_REFUSE_THRESHOLD=0.08
DOCQA_MAX_CITATION_COUNT=3

